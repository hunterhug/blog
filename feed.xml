---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.domain }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.domain }}{{ "/feed.xml" | prepend: site.baseurl }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% for post in site.posts limit:10 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        {% if post.desc %}
        <description>{{ post.desc | xml_escape }}</description>
        {% else %}
        <description>{{ post.content | slice: 0, 50 | xml_escape }}</description>
        {% endif %}
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ site.domain }}{{ post.url | prepend: site.baseurl }}</link>
        <guid isPermaLink="true">{{ site.domain }}{{ post.url | prepend: site.baseurl }}</guid>
        {% for tag in post.tags %}
        <tag>{{ tag | xml_escape }}</tag>
        {% endfor %}
        {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
